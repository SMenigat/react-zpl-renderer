{
  "name": "react-zpl-renderer",
  "description": "A React component for rendering ZPL (Zebra Programming Language) labels using zpl-js.",
  "author": "Samuel Menigat <samuel.menigat@gmail.com>",
  "license": "MIT",
  "version": "1.6.0",
  "type": "module",
  "main": "dist/index.cjs.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.esm.js",
      "require": "./dist/index.cjs.js",
      "default": "./dist/index.cjs.js"
    }
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "react",
    "react-component",
    "zpl",
    "zebra",
    "zebra-programming-language",
    "label",
    "label-printer",
    "barcode",
    "rendering",
    "typescript"
  ],
  "scripts": {
    "build": "rimraf dist && rollup -c",
    "watch": "rollup -c -w",
    "lint": "prettier --check .",
    "format": "prettier --write .",
    "prepublishOnly": "yarn build",
    "test:open": "cypress open --component --browser electron",
    "test:run": "cypress run --component"
  },
  "dependencies": {
    "zpl-js": "^0.1.5"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@babel/preset-env": "^7.28.0",
    "@babel/preset-react": "^7.27.1",
    "@babel/preset-typescript": "^7.27.1",
    "@cypress/react": "^9.0.1",
    "@rollup/plugin-babel": "^6.0.4",
    "@rollup/plugin-commonjs": "^28.0.1",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@rollup/plugin-typescript": "^12.1.1",
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^5.0.1",
    "cypress": "^14.5.3",
    "prettier": "^3.6.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "rimraf": "^6.0.1",
    "rollup": "^4.29.1",
    "rollup-plugin-dts": "^6.2.1",
    "tslib": "^2.8.1",
    "typescript": ">=3.0.0",
    "vite": "^6.0.0"
  },
  "peerDependencies": {
    "react": ">=16.8.0",
    "react-dom": ">=16.8.0"
  }
}
