{
  "trailingComma": "es5",
  "tabWidth": 2,
  "semi": true,
  "singleQuote": true,
  "printWidth": 80,
  "importOrder": [
    "^react",
    "<THIRD_PARTY_MODULES>",
    "^@/components/ApiClient/",
    "^@/containers/",
    "^@/components/",
    "^@/"
  ],
  "importOrderSeparation": false,
  "importOrderSortSpecifiers": true,
  "plugins": ["@trivago/prettier-plugin-sort-imports"]
}
